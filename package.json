{
  "name": "amdm",
  "version": "26.8.17",
  "description": "AMDM (Another Mongo Desktop Manager) — a lean, performance-first desktop GUI for MongoDB (NoSQLBooster alternative)",
  "main": "./out/main/index.js",
  "author": "shawn",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract",
    "test:integration": "vitest run test/integration",
    "clean": "node -e \"for (const path of ['out', 'dist', 'coverage', 'tsconfig.node.tsbuildinfo', 'tsconfig.web.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepare:sparkle": "node scripts/prepare-sparkle.mjs",
    "generate:sparkle-appcast": "node scripts/generate-sparkle-appcast.mjs",
    "dist:prepare": "pnpm clean && pnpm build && pnpm prepare:sparkle",
    "dist": "pnpm dist:prepare && electron-builder",
    "dist:dir": "pnpm dist:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "install:mac": "pnpm dist:dir --mac --arm64 && if pgrep -x AMDM >/dev/null; then osascript -e 'tell application \"AMDM\" to quit'; while pgrep -x AMDM >/dev/null; do sleep 0.1; done; fi && rm -rf /Applications/AMDM.app && ditto dist/mac-arm64/AMDM.app /Applications/AMDM.app && open /Applications/AMDM.app"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "bson": "^7.3.2",
    "mongodb": "^7.5.0",
    "mongodb-connection-string-url": "^7.0.2",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@base-ui/react": "1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mongodb-js/mongodb-schema": "^12.7.3",
    "@mongosh/async-rewriter2": "^2.4.19",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "mongodb-memory-server": "^11.2.0",
    "node-api-headers": "^1.9.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
