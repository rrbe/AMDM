{
  "name": "amdm",
  "version": "26.10.2",
  "description": "AMDM (Another Mongo Desktop Manager) — a lean, performance-first desktop GUI for MongoDB (NoSQLBooster alternative)",
  "main": "./out/main/index.js",
  "author": "shawn",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:mongosh-runtime": "node scripts/build-mongosh-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "pretest": "pnpm build:mongosh-runtime",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract",
    "pretest:integration": "pnpm build:mongosh-runtime",
    "test:integration": "vitest run test/integration",
    "clean": "node -e \"for (const path of ['out', 'dist', 'coverage', 'tsconfig.node.tsbuildinfo', 'tsconfig.web.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepare:sparkle": "node scripts/prepare-sparkle.mjs",
    "generate:sparkle-appcast": "node scripts/generate-sparkle-appcast.mjs",
    "dist:prepare": "pnpm clean && pnpm build && pnpm prepare:sparkle",
    "dist": "pnpm dist:prepare && electron-builder",
    "dist:dir": "pnpm dist:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "install:mac": "pnpm dist:dir --mac --arm64 --config.electronDist=node_modules/electron/dist && if pgrep -x AMDM >/dev/null; then osascript -e 'tell application \"AMDM\" to quit'; while pgrep -x AMDM >/dev/null; do sleep 0.1; done; fi && rm -rf /Applications/AMDM.app && ditto dist/mac-arm64/AMDM.app /Applications/AMDM.app && open /Applications/AMDM.app"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "bson": "^7.3.3",
    "electron-updater": "^6.8.9",
    "mongodb": "^7.7.0",
    "mongodb-connection-string-url": "^7.0.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@mongodb-js/mongodb-schema": "^12.8.7",
    "@mongosh/service-provider-node-driver": "5.6.2",
    "@mongosh/shell-api": "5.9.2",
    "@mongosh/shell-evaluator": "5.9.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "esbuild": "0.28.2",
    "exceljs": "^4.4.0",
    "fuse.js": "7.5.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.54.0",
    "mongodb-memory-server": "^11.3.0",
    "node-api-headers": "^1.9.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1",
      "get-uri>basic-ftp": "6.2.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
